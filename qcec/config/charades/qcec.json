{
  "dataset": {
    "dataset": "CharadesSTA",
    "feature_path": "/data/chenyuan/videogrounding/VGDataset/Charades-STA/i3dfeatures/i3d_features.hdf5",
    "vocab_size": 1111,
    "word_dim": 300,
    "frame_dim": 1024,
    "max_num_words": 20,
    "max_num_frames": 200,
    "target_stride": 1,
    "train_data": "data/charades/train.json",
    "test_data": "data/charades/test.json",
    "val_data": "data/charades/test.json",
    "vocab_path": "data/charades/glove.pkl",
    "qcec_cluster_index_path": "data/charades/qcec_clusters_m32.npz",
    "qcec_num_clusters": 32,
    "qcec_l2_normalize": true,
    "return_query_roles": true
  },
  "train": {
    "optimizer": {
      "lr": 4e-4,
      "weight_decay": 0,
      "warmup_updates": 400,
      "warmup_init_lr": 1e-7
    },
    "batch_size": 32,
    "max_num_epochs": 30,
    "model_saved_path": "checkpoints/charades/"
  },
  "model": {
    "name": "CPL",
    "config": {
      "frames_input_size": 1024,
      "words_input_size": 300,
      "hidden_size": 256,
      "use_negative": true,
      "num_props": 8,
      "sigma": 9,
      "gamma": 0.5,
      "dropout": 0.1,
      "event_disentanglement": {
        "enabled": true,
        "rank": 8,
        "cpca_alpha": 1.0,
        "covariance_ema": 0.95,
        "normalize_covariance": true,
        "selection_temperature": 0.1,
        "warmup_epochs": 5,
        "ramp_epochs": 5,
        "score_separation_weight": 0.5,
        "inference_event_weight": 0.1,
        "inference_vote_event_weight": 0.5
      },
      "qcec": {
        "enabled": true,
        "num_clusters": 32,
        "edge_boost": 1.0,
        "edge_power": 2.0,
        "attention_dim": 256,
        "relevance_temperature": 0.1,
        "relevance_change_margin": 0.05,
        "transition_threshold": 0.2,
        "transition_temperature": 0.05,
        "use_slot_prior": false,
        "prior_bias_scale": 0.25,
        "freeze_backbone_epochs": 3,
        "snap_enabled": false,
        "snap_radius_frames": 2,
        "snap_min_confidence": 0.15,
        "snap_min_relevance": 0.5,
        "snap_min_width": 0.01,
        "snap_edge_min_confidence": 0.75,
        "return_debug_tensors": false
      },
      "DualTransformer": {
        "d_model": 256,
        "num_heads": 4,
        "num_decoder_layers1": 3,
        "num_decoder_layers2": 3,
        "dropout": 0.1
      }
    }
  },
  "loss": {
    "margin_1": 0.1,
    "margin_2": 0.15,
    "lambda": 0.146,
    "alpha_1": 1,
    "alpha_2": 5,
    "event_alpha": 0.1,
    "event_margin": 0.2,
    "event_text_weight": 1.0,
    "event_min_context": 0.15,
    "event_context_weight": 2.0,
    "event_max_overlap": 0.7,
    "event_overlap_weight": 1.0,
    "qcec_cross_weight": 0.1,
    "qcec_cross_temperature": 0.02,
    "qcec_detach_barrier": true,
    "qcec_component_cross_weight": 0.0,
    "qcec_boundary_align_weight": 0.0
  }
}
