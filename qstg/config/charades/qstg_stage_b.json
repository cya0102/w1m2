{
  "dataset": {
    "dataset": "CharadesSTA",
    "feature_path": "/data/chenyuan/videogrounding/VGDataset/Charades-STA/i3dfeatures/i3d_features.hdf5",
    "vocab_size": 1111, "word_dim": 300, "frame_dim": 1024,
    "max_num_words": 20, "max_num_frames": 200, "target_stride": 1,
    "train_data": "data/charades/train_qstg.json",
    "test_data": "data/charades/test.json",
    "val_data": "data/charades/val_qstg.json",
    "vocab_path": "data/charades/glove.pkl", "max_phrases": 8,
    "phrase_graph": {"enabled": true, "max_actions": 2,
      "max_entities": 3, "max_relations": 1,
      "allow_global_fallback": true}
  },
  "train": {
    "optimizer": {"lr": 1e-4, "weight_decay": 0,
      "warmup_updates": 400, "warmup_init_lr": 1e-7},
    "batch_size": 32, "max_num_epochs": 10,
    "model_saved_path": "checkpoints/charades/stage_b/"
  },
  "model": {"name": "CPL", "config": {
    "frames_input_size": 1024, "words_input_size": 300,
    "hidden_size": 256, "use_negative": true, "num_props": 8,
    "sigma": 9, "gamma": 0.5, "dropout": 0.1,
    "event_disentanglement": {"enabled": true, "rank": 8,
      "cpca_alpha": 1.0, "covariance_ema": 0.95,
      "normalize_covariance": true, "selection_temperature": 0.1,
      "warmup_epochs": 5, "ramp_epochs": 5,
      "score_separation_weight": 0.5, "inference_event_weight": 0.0,
      "inference_vote_event_weight": 0.0},
    "DualTransformer": {"d_model": 256, "num_heads": 4,
      "num_decoder_layers1": 3, "num_decoder_layers2": 3,
      "dropout": 0.1},
    "qstg": {"enabled": true, "max_phrases": 8, "node_stride": 4,
      "num_query_graph_layers": 1, "num_graph_layers": 2,
      "num_graph_heads": 4, "max_temporal_hop": 4, "similar_topk": 2,
      "similarity_threshold": 0.5, "keep_ratio": 0.5,
      "gate_floor": 0.05, "gate_temperature": 0.1,
      "binding_temperature": 0.1, "final_binding_temperature": 0.1,
      "relation_bias_scale": 0.5, "relation_decay": 4.0,
      "simultaneous_decay": 1.5, "transition_threshold": 0.2,
      "transition_temperature": 0.05, "proposal_prior_scale": 0.0,
      "importance_bias_scale": 0.0, "component_residual_enabled": true,
      "quality_head_enabled": true, "allow_global_fallback": false,
      "membership_threshold": 0.1, "soft_box_temperature": 0.02,
      "connected_refine": false, "graph_dropout": 0.1,
      "return_diagnostics": false}
  }},
  "loss": {
    "margin_1": 0.1, "margin_2": 0.15, "lambda": 0.146,
    "alpha_1": 1, "alpha_2": 5, "event_alpha": 0.1,
    "event_margin": 0.2, "event_text_weight": 1.0,
    "event_min_context": 0.15, "event_context_weight": 2.0,
    "event_max_overlap": 0.7, "event_overlap_weight": 1.0,
    "qstg_total_weight": 1.0, "qstg_mc_weight": 0.05,
    "qstg_proposal_weight": 0.05, "qstg_fa_weight": 0.1,
    "qstg_explain_weight": 0.03, "qstg_gate_weight": 0.01,
    "qstg_connect_weight": 0.05, "qstg_role_weight": 0.0,
    "qstg_mc_temperature": 0.07, "qstg_reconstruction_temperature": 0.1,
    "qstg_fa_temperature": 0.1, "qstg_fa_margin": 0.2,
    "qstg_selector_confidence_margin": 0.05,
    "qstg_gate_min_ratio": 0.1, "qstg_gate_max_ratio": 0.7,
    "qstg_detach_selector": true, "qstg_detach_barrier": true
  },
  "selection_strategy": "qstg", "qstg_quality_weight": 0.2,
  "qstg_analytic_weight": 0.1, "selection_temperature": 0.1,
  "eval_mask_mode": "deterministic", "qstg_stage": "B",
  "trainable_scope": "qstg_and_proposal", "detach_base_states": true
}
